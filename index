function deleteStudent(studentId) {

    const student =
        getStudent(studentId);

    if (!student) {
        return;
    }


    const hasLessons =
        db.lessons.some(
            lesson =>
                lesson.studentId === studentId
        );


    const hasPayments =
        db.payments.some(
            payment =>
                payment.studentId === studentId
        );


    if (hasLessons || hasPayments) {

        alert(
            "No se puede eliminar este alumno porque tiene clases o pagos registrados. Esto evita perder información histórica."
        );

        return;
    }


    if (
        !confirm(
            `¿Eliminar a ${student.name}?`
        )
    ) {
        return;
    }


    db.students =
        db.students.filter(
            s => s.id !== studentId
        );


    saveDatabase();
    render();

    showToast("Alumno eliminado");
}


