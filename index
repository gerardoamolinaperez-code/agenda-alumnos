<body>

<div class="app">

    <header class="header">
        <div class="header-title">Agenda de alumnos particulares</div>
        <div class="header-subtitle">Gestión de alumnos y clases</div>
    </header>

    <nav class="nav" id="nav"></nav>

    <main class="content" id="content"></main>

</div>

<button class="fab" id="fab" title="Nueva clase">+</button>

<div class="modal-backdrop" id="modalBackdrop">
    <div class="modal" id="modal"></div>
</div>

<div class="toast" id="toast"></div>


<script>

/* =========================================================
   CONFIGURACIÓN Y BASE DE DATOS
   ========================================================= */

const STORAGE_KEY = "agenda_tutor_v4_final";

const DEFAULT_DB = {
    students: [],
    lessons: [],
    payments: []
};

let db = loadDatabase();

let state = {
    section: "calendar",
    currentMonth: new Date(),
    selectedDate: new Date()
};


/* =========================================================
   FUNCIONES GENERALES
   ========================================================= */

function loadDatabase() {

    try {

        const saved = localStorage.getItem(STORAGE_KEY);

        if (!saved) {
            return structuredClone(DEFAULT_DB);
        }

        const data = JSON.parse(saved);

        return {
            students: Array.isArray(data.students) ? data.students : [],
            lessons: Array.isArray(data.lessons) ? data.lessons : [],
            payments: Array.isArray(data.payments) ? data.payments : []
        };

    } catch (error) {

        console.error("Error leyendo datos:", error);

        return structuredClone(DEFAULT_DB);
    }
}


function saveDatabase() {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(db)
    );
}


function generateId(prefix = "id") {

    if (window.crypto && crypto.randomUUID) {
        return crypto.randomUUID();
    }

    return prefix + "_" + Date.now() + "_" + Math.random().toString(36).slice(2);
}


function formatMoney(value) {

    return new Intl.NumberFormat("es-AR", {
        style: "currency",
        currency: "ARS",
        maximumFractionDigits: 0
    }).format(Number(value) || 0);
}


/*
    MUY IMPORTANTE:

    No usamos new Date("2026-09-30")
    porque eso puede interpretarse como UTC.

    Creamos siempre las fechas manualmente.
*/

function dateKey(year, month, day) {

    return (
        String(year) +
        "-" +
        String(month + 1).padStart(2, "0") +
        "-" +
        String(day).padStart(2, "0")
    );
}


function dateKeyFromDate(date) {

    return dateKey(
        date.getFullYear(),
        date.getMonth(),
        date.getDate()
    );
}


function dateFromKey(key) {

    const parts = key.split("-").map(Number);

    return new Date(
        parts[0],
        parts[1] - 1,
        parts[2],
        12,
        0,
        0,
        0
    );
}


function todayKey() {

    return dateKeyFromDate(new Date());
}


function escapeHTML(value) {

    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


function formatDate(date) {

    return date.toLocaleDateString("es-AR", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric"
    });
}


function showToast(message) {

    const toast = document.getElementById("toast");

    toast.textContent = message;
    toast.classList.add("show");

    setTimeout(() => {
        toast.classList.remove("show");
    }, 2200);
}


/* =========================================================
   ALUMNOS
   ========================================================= */

function getStudent(id) {

    return db.students.find(student => student.id === id);
}


function getStudentBalance(studentId) {

    const charged = db.lessons
        .filter(lesson =>
            lesson.studentId === studentId &&
            lesson.status !== "absent"
        )
        .reduce(
            (total, lesson) => total + Number(lesson.price || 0),
            0
        );

    const paid = db.payments
        .filter(payment => payment.studentId === studentId)
        .reduce(
            (total, payment) => total + Number(payment.amount || 0),
            0
        );

    return Math.max(0, charged - paid);
}


function getTotalPending() {

    return db.students.reduce(
        (total, student) =>
            total + getStudentBalance(student.id),
        0
    );
}


/**
 * Asigna los pagos de un alumno de forma FIFO
 * (clases más antiguas primero).
 * Devuelve las clases que todavía tienen saldo pendiente,
 * con el monto que aún se adeuda de cada una.
 */
function getStudentPendingLessons(studentId) {

    const totalPaid = db.payments
        .filter(p => p.studentId === studentId)
        .reduce((sum, p) => sum + Number(p.amount || 0), 0);

    const lessons = db.lessons
        .filter(l =>
            l.studentId === studentId &&
            l.status !== "absent"
        )
        .slice()
        .sort((a, b) => {
            const dateCmp = a.date.localeCompare(b.date);
            if (dateCmp !== 0) return dateCmp;
            return a.time.localeCompare(b.time);
        });

    let remainingPaid = totalPaid;
    const pending = [];

    for (const lesson of lessons) {

        const price = Number(lesson.price) || 0;

        if (remainingPaid >= price) {
            remainingPaid -= price;
            continue;
        }

        const owed = price - remainingPaid;
        pending.push({
            ...lesson,
            owed,
            originalPrice: price,
            partial: remainingPaid > 0
        });
        remainingPaid = 0;
    }

    return pending;
}


/**
 * Estado de pago FIFO por clase asistida:
 * "yes" | "partial" | "no"
 */
function getAttendedPaidStatusMap(studentId) {

    const totalPaid = db.payments
        .filter(p => p.studentId === studentId)
        .reduce((sum, p) => sum + Number(p.amount || 0), 0);

    const lessons = db.lessons
        .filter(l =>
            l.studentId === studentId &&
            l.status === "attended"
        )
        .slice()
        .sort((a, b) => {
            const dateCmp = a.date.localeCompare(b.date);
            if (dateCmp !== 0) return dateCmp;
            return a.time.localeCompare(b.time);
        });

    const map = {};
    let remainingPaid = totalPaid;

    for (const lesson of lessons) {
        const price = Number(lesson.price) || 0;
        if (remainingPaid >= price) {
            remainingPaid -= price;
            map[lesson.id] = "yes";
        } else if (remainingPaid > 0) {
            map[lesson.id] = "partial";
            remainingPaid = 0;
        } else {
            map[lesson.id] = "no";
        }
    }

    return map;
}


/**
 * Modal: borrar historial del alumno hasta una fecha.
 * Se eliminan: asistidas totalmente pagadas y faltas.
 * Se conservan: pendientes, pago parcial y adeudadas.
 * Los pagos se ajustan por el monto de las asistidas borradas.
 */
function openClearUntilModal(studentId) {

    const student = getStudent(studentId);

    if (!student) {
        return;
    }

    const modal = document.getElementById("modal");

    modal.innerHTML = `

        <div class="modal-header">
            <div class="modal-title">
                Borrar historial hasta…
            </div>
            <button class="close" id="closeModal">×</button>
        </div>

        <p class="small muted" style="margin-top:0">
            Alumno: <b>${escapeHTML(student.name)}</b>
        </p>

        <p class="small muted">
            Se borrarán las clases hasta la fecha indicada (inclusive),
            excepto las <b>pendientes</b>, las con <b>pago parcial</b>
            y las que todavía se <b>adeudan</b>.
            Las asistidas totalmente pagadas que se borren
            descontarán el mismo monto de los pagos.
        </p>

        <div class="form-group">
            <label>Borrar clases hasta (inclusive)</label>
            <input
                type="date"
                id="clearUntilDate"
                value="${todayKey()}"
            >
        </div>

        <div class="actions">
            <button class="btn-secondary" id="cancelClearUntil">
                Cancelar
            </button>
            <button class="btn-danger" id="confirmClearUntil">
                Revisar y borrar
            </button>
        </div>

    `;

    openModal();

    document.getElementById("closeModal")
        .addEventListener("click", closeModal);

    document.getElementById("cancelClearUntil")
        .addEventListener("click", closeModal);

    document.getElementById("confirmClearUntil")
        .addEventListener("click", () => {

            const until = document.getElementById("clearUntilDate").value;

            if (!until) {
                alert("Seleccioná una fecha.");
                return;
            }

            clearLessonsUntilDate(studentId, until);
        });
}


function clearLessonsUntilDate(studentId, untilDate) {

    const student = getStudent(studentId);

    if (!student) {
        return;
    }

    const paidMap = getAttendedPaidStatusMap(studentId);

    const candidates = db.lessons.filter(l =>
        l.studentId === studentId &&
        l.date <= untilDate
    );

    const toDelete = [];
    let paymentReduce = 0;
    let countAbsent = 0;
    let countPaid = 0;

    for (const lesson of candidates) {
        const st = lesson.status || "pending";

        // Pendientes (indeterminadas): no borrar
        if (st === "pending") {
            continue;
        }

        // Faltas: se pueden archivar (no afectan saldo)
        if (st === "absent") {
            toDelete.push(lesson);
            countAbsent++;
            continue;
        }

        // Asistidas: solo si están totalmente pagadas
        if (st === "attended") {
            const payStatus = paidMap[lesson.id];
            if (payStatus === "yes") {
                toDelete.push(lesson);
                paymentReduce += Number(lesson.price) || 0;
                countPaid++;
            }
            // partial / no → se conservan
        }
    }

    if (toDelete.length === 0) {
        alert(
            "No hay clases para borrar hasta esa fecha " +
            "(solo quedarían pendientes, parciales o adeudadas)."
        );
        return;
    }

    const ok = confirm(
        `Alumno: ${student.name}\n` +
        `Hasta: ${formatLessonDate(untilDate)}\n\n` +
        `Se eliminarán ${toDelete.length} clase(s):\n` +
        `· ${countPaid} asistida(s) totalmente pagada(s)\n` +
        `· ${countAbsent} falta(s)\n\n` +
        (paymentReduce > 0
            ? `Se ajustarán pagos por ${formatMoney(paymentReduce)}.\n\n`
            : "") +
        `Se conservan pendientes, pagos parciales y clases adeudadas.\n\n` +
        `¿Continuar?`
    );

    if (!ok) {
        return;
    }

    const idsToRemove = new Set(toDelete.map(l => l.id));
    db.lessons = db.lessons.filter(l => !idsToRemove.has(l.id));

    if (paymentReduce > 0) {
        let toConsume = paymentReduce;

        const studentPayments = db.payments
            .filter(p => p.studentId === studentId)
            .slice()
            .sort((a, b) => {
                const dateCmp = String(a.date).localeCompare(String(b.date));
                if (dateCmp !== 0) return dateCmp;
                return String(a.id).localeCompare(String(b.id));
            });

        const paymentIdsToDelete = new Set();

        for (const payment of studentPayments) {
            if (toConsume <= 0) break;

            const amount = Number(payment.amount) || 0;

            if (amount <= toConsume) {
                toConsume -= amount;
                paymentIdsToDelete.add(payment.id);
            } else {
                payment.amount = amount - toConsume;
                toConsume = 0;
            }
        }

        if (paymentIdsToDelete.size > 0) {
            db.payments = db.payments.filter(
                p => !paymentIdsToDelete.has(p.id)
            );
        }
    }

    saveDatabase();
    closeModal();
    render();

    showToast(`${toDelete.length} clase(s) eliminada(s)`);
}


function formatLessonDate(dateKeyStr) {

    try {
        const d = dateFromKey(dateKeyStr);
        return d.toLocaleDateString("es-AR", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric"
        });
    } catch {
        return dateKeyStr;
    }
}


/* =========================================================
   NAVEGACIÓN
   ========================================================= */

function renderNavigation() {

    const nav = document.getElementById("nav");

    const sections = [
        ["calendar", "Mes"],
        ["day", "Día"],
        ["students", "Alumnos"],
        ["payments", "Pagos"],
        ["data", "Datos"]
    ];

    nav.innerHTML = sections.map(section => `
        <button
            class="${state.section === section[0] ? "active" : ""}"
            data-section="${section[0]}"
        >
            ${section[1]}
        </button>
    `).join("");

    nav.querySelectorAll("[data-section]").forEach(button => {

        button.addEventListener("click", () => {

            state.section = button.dataset.section;

            render();
        });

    });
}


/* =========================================================
   RENDER PRINCIPAL
   ========================================================= */

function render() {

    saveDatabase();

    renderNavigation();

    switch (state.section) {

        case "calendar":
            renderCalendar();
            break;

        case "day":
            renderDay();
            break;

        case "students":
            renderStudents();
            break;

        case "payments":
            renderPayments();
            break;

        case "data":
            renderData();
            break;

    }
}


/* =========================================================
   CALENDARIO
   ========================================================= */

function renderCalendar() {

    const content = document.getElementById("content");

    const year = state.currentMonth.getFullYear();
    const month = state.currentMonth.getMonth();

    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);

    /*
       Convertimos domingo=0 a lunes=0.
    */

    const firstWeekday =
        (firstDay.getDay() + 6) % 7;

    const selectedKey =
        dateKeyFromDate(state.selectedDate);

    let html = `
        <div class="dashboard">

            <div class="stat">
                <div class="stat-label">Clases hoy</div>
                <div class="stat-value">
                    ${db.lessons.filter(l => l.date === todayKey()).length}
                </div>
            </div>

            <div class="stat">
                <div class="stat-label">Alumnos</div>
                <div class="stat-value">
                    ${db.students.length}
                </div>
            </div>

            <div class="stat">
                <div class="stat-label">Pendiente</div>
                <div class="stat-value">
                    ${formatMoney(getTotalPending())}
                </div>
            </div>

        </div>

        <div class="card">

            <div class="calendar-header">

                <button
                    class="btn-secondary"
                    id="previousMonth"
                >
                    ◀
                </button>

                <div class="calendar-title">
                    ${state.currentMonth.toLocaleDateString(
                        "es-AR",
                        {
                            month: "long",
                            year: "numeric"
                        }
                    )}
                </div>

                <button
                    class="btn-secondary"
                    id="nextMonth"
                >
                    ▶
                </button>

            </div>

            <div class="weekdays">
                ${["L","M","X","J","V","S","D"]
                    .map(day => `<div class="weekday">${day}</div>`)
                    .join("")
                }
            </div>

            <div class="calendar-grid">
    `;

    for (let i = 0; i < firstWeekday; i++) {
        html += `<div></div>`;
    }

    for (let day = 1; day <= lastDay.getDate(); day++) {

        const key = dateKey(year, month, day);

        const lessons = db.lessons
            .filter(lesson => lesson.date === key)
            .sort((a, b) =>
                a.time.localeCompare(b.time)
            );

        const classes = [
            "calendar-day"
        ];

        if (key === todayKey()) {
            classes.push("today");
        }

        if (key === selectedKey) {
            classes.push("selected");
        }

        html += `
            <div
                class="${classes.join(" ")}"
                data-date="${key}"
            >

                <div class="day-number">
                    ${day}
                </div>

                ${lessons.slice(0, 3).map(lesson => {

                    const student = getStudent(lesson.studentId);

                    let statusClass = "";

                    if (lesson.status === "attended") {
                        statusClass = "attended";
                    }

                    if (lesson.status === "absent") {
                        statusClass = "absent";
                    }

                    return `
                        <div class="lesson-mini ${statusClass}">
                            ${escapeHTML(lesson.time)}
                            ${student ? " " + escapeHTML(student.name) : ""}
                        </div>
                    `;

                }).join("")}

                ${
                    lessons.length > 3
                    ? `<div class="small muted">+${lessons.length - 3} más</div>`
                    : ""
                }

            </div>
        `;
    }

    html += `
            </div>
        </div>

        <div class="card">

            <div class="card-title">
                Acciones rápidas
            </div>

            <button
                class="btn"
                id="newClassCalendar"
            >
                + Agregar clase
            </button>

        </div>
    `;

    content.innerHTML = html;

    document
        .getElementById("previousMonth")
        .addEventListener("click", () => {

            state.currentMonth = new Date(
                year,
                month - 1,
                1
            );

            render();

        });


    document
        .getElementById("nextMonth")
        .addEventListener("click", () => {

            state.currentMonth = new Date(
                year,
                month + 1,
                1
            );

            render();

        });


    document
        .querySelectorAll("[data-date]")
        .forEach(dayElement => {

            dayElement.addEventListener("click", () => {

                state.selectedDate =
                    dateFromKey(dayElement.dataset.date);

                state.section = "day";

                render();

            });

        });


    document
        .getElementById("newClassCalendar")
        .addEventListener("click", () => {

            openLessonModal(
                dateKeyFromDate(state.selectedDate)
            );

        });
}


/* =========================================================
   AGENDA DEL DÍA
   ========================================================= */

function renderDay() {

    const content = document.getElementById("content");

    const key =
        dateKeyFromDate(state.selectedDate);

    const lessons = db.lessons
        .filter(lesson => lesson.date === key)
        .sort((a, b) =>
            a.time.localeCompare(b.time)
        );

    let html = `

        <div class="card">

            <div class="calendar-header">

                <button
                    class="btn-secondary"
                    id="previousDay"
                >
                    ◀
                </button>

                <div class="calendar-title">
                    ${escapeHTML(formatDate(state.selectedDate))}
                </div>

                <button
                    class="btn-secondary"
                    id="nextDay"
                >
                    ▶
                </button>

            </div>

            <button
                class="btn"
                id="newClassDay"
            >
                + Nueva clase
            </button>

        </div>
    `;


    if (lessons.length === 0) {

        html += `
            <div class="card empty">
                No hay clases para este día.
            </div>
        `;

    } else {

        html += lessons.map(lesson => {

            const student =
                getStudent(lesson.studentId);

            let statusText = "Pendiente";
            let statusClass = "pending";

            if (lesson.status === "attended") {
                statusText = "Asistió";
                statusClass = "attended";
            }

            if (lesson.status === "absent") {
                statusText = "Faltó";
                statusClass = "absent";
            }

            return `

                <div class="lesson">

                    <div class="lesson-main">

                        <div class="lesson-time">
                            ${escapeHTML(lesson.time)}
                        </div>

                        <div style="flex:1">

                            <div class="lesson-name">
                                ${student
                                    ? escapeHTML(student.name)
                                    : "Alumno eliminado"
                                }
                            </div>

                            <div class="lesson-info">
                                ${lesson.duration} min ·
                                ${formatMoney(lesson.price)}
                            </div>

                        </div>

                        <span class="status ${statusClass}">
                            ${statusText}
                        </span>

                    </div>

                    <div class="actions">

                        <button
                            class="btn-success"
                            data-attend="${lesson.id}"
                        >
                            Asistió
                        </button>

                        <button
                            class="btn-warning"
                            data-absent="${lesson.id}"
                        >
                            Faltó
                        </button>

                        <button
                            class="btn-secondary"
                            data-edit-lesson="${lesson.id}"
                        >
                            Editar
                        </button>

                        <button
                            class="btn-danger"
                            data-delete-lesson="${lesson.id}"
                        >
                            Eliminar
                        </button>

                        ${
                            student && student.phone
                            ? `
                                <button
                                    class="btn-secondary"
                                    data-whatsapp="${lesson.id}"
                                >
                                    WhatsApp
                                </button>
                            `
                            : ""
                        }

                    </div>

                </div>

            `;

        }).join("");

    }

    content.innerHTML = html;


    document
        .getElementById("previousDay")
        .addEventListener("click", () => {

            state.selectedDate = new Date(
                state.selectedDate.getFullYear(),
                state.selectedDate.getMonth(),
                state.selectedDate.getDate() - 1,
                12
            );

            render();

        });


    document
        .getElementById("nextDay")
        .addEventListener("click", () => {

            state.selectedDate = new Date(
                state.selectedDate.getFullYear(),
                state.selectedDate.getMonth(),
                state.selectedDate.getDate() + 1,
                12
            );

            render();

        });


    document
        .getElementById("newClassDay")
        .addEventListener("click", () => {

            openLessonModal(key);

        });


    document
        .querySelectorAll("[data-attend]")
        .forEach(button => {

            button.addEventListener("click", () => {

                const lesson =
                    db.lessons.find(
                        x => x.id === button.dataset.attend
                    );

                if (lesson) {
                    lesson.status = "attended";
                    saveDatabase();
                    render();
                }

            });

        });


    document
        .querySelectorAll("[data-absent]")
        .forEach(button => {

            button.addEventListener("click", () => {

                const lesson =
                    db.lessons.find(
                        x => x.id === button.dataset.absent
                    );

                if (lesson) {
                    lesson.status = "absent";
                    saveDatabase();
                    render();
                }

            });

        });


    document
        .querySelectorAll("[data-edit-lesson]")
        .forEach(button => {

            button.addEventListener("click", () => {

                openLessonModal(
                    key,
                    button.dataset.editLesson
                );

            });

        });


    document
        .querySelectorAll("[data-delete-lesson]")
        .forEach(button => {

            button.addEventListener("click", () => {

                if (
                    !confirm(
                        "¿Querés eliminar esta clase?"
                    )
                ) {
                    return;
                }

                db.lessons =
                    db.lessons.filter(
                        lesson =>
                            lesson.id !== button.dataset.deleteLesson
                    );

                saveDatabase();
                render();

            });

        });


    document
        .querySelectorAll("[data-whatsapp]")
        .forEach(button => {

            button.addEventListener("click", () => {

                const lesson =
                    db.lessons.find(
                        x => x.id === button.dataset.whatsapp
                    );

                const student =
                    lesson
                        ? getStudent(lesson.studentId)
                        : null;

                if (!student || !student.phone) {
                    alert(
                        "Este alumno no tiene un número de WhatsApp."
                    );
                    return;
                }

                const message =
                    `Hola ${student.name}, te recuerdo tu clase de hoy a las ${lesson.time}.`;

                const phone =
                    normalizePhone(student.phone);

                window.open(
                    `https://wa.me/${phone}?text=${encodeURIComponent(message)}`,
                    "_blank"
                );

            });

        });

}


/* =========================================================
   MODAL DE CLASE
   ========================================================= */

function openLessonModal(dateKeyValue, lessonId = null) {

    if (db.students.length === 0) {

        alert(
            "Primero tenés que cargar al menos un alumno."
        );

        state.section = "students";
        render();

        return;
    }


    const editingLesson =
        lessonId
            ? db.lessons.find(
                lesson => lesson.id === lessonId
            )
            : null;


    const defaultStudent =
        editingLesson
            ? editingLesson.studentId
            : db.students[0].id;


    const defaultTime =
        editingLesson
            ? editingLesson.time
            : "16:00";


    const defaultDuration =
        editingLesson
            ? editingLesson.duration
            : 60;


    const defaultPrice =
        editingLesson
            ? editingLesson.price
            : (
                getStudent(defaultStudent)?.price ||
                10000
            );


    const modal =
        document.getElementById("modal");


    modal.innerHTML = `

        <div class="modal-header">

            <div class="modal-title">
                ${editingLesson
                    ? "Editar clase"
                    : "Nueva clase"
                }
            </div>

            <button
                class="close"
                id="closeModal"
            >
                ×
            </button>

        </div>


        <div class="form-group">

            <label>Fecha</label>

            <input
                type="date"
                id="lessonDate"
                value="${dateKeyValue}"
            >

        </div>


        <div class="form-group">

            <label>Alumno</label>

            <select id="lessonStudent">

                ${db.students.map(student => `
                    <option
                        value="${student.id}"
                        ${student.id === defaultStudent ? "selected" : ""}
                    >
                        ${escapeHTML(student.name)}
                    </option>
                `).join("")}

            </select>

        </div>


        <div class="form-row">

            <div class="form-group">

                <label>Hora</label>

                <input
                    type="time"
                    id="lessonTime"
                    value="${defaultTime}"
                >

            </div>


            <div class="form-group">

                <label>Duración</label>

                <select id="lessonDuration">

                    ${[30, 60, 90, 120].map(minutes => `
                        <option
                            value="${minutes}"
                            ${Number(defaultDuration) === minutes ? "selected" : ""}
                        >
                            ${minutes} minutos
                        </option>
                    `).join("")}

                </select>

            </div>

        </div>


        <div class="form-group">

            <label>Precio de esta clase ($)</label>

            <input
                type="number"
                id="lessonPrice"
                min="0"
                step="1"
                value="${Number(defaultPrice) || 0}"
            >

        </div>


        <div class="actions">

            <button
                class="btn-secondary"
                id="cancelLesson"
            >
                Cancelar
            </button>

            <button
                class="btn"
                id="saveLesson"
            >
                ${editingLesson
                    ? "Guardar cambios"
                    : "Agregar clase"
                }
            </button>

        </div>

    `;


    openModal();


    document
        .getElementById("closeModal")
        .addEventListener("click", closeModal);


    document
        .getElementById("cancelLesson")
        .addEventListener("click", closeModal);


    /*
        Al cambiar de alumno, proponemos
        automáticamente su precio habitual.
    */

    document
        .getElementById("lessonStudent")
        .addEventListener("change", event => {

            const student =
                getStudent(event.target.value);

            if (student && !editingLesson) {

                document.getElementById("lessonPrice").value =
                    Number(student.price) || 0;

            }

        });


    document
        .getElementById("saveLesson")
        .addEventListener("click", () => {

            const date =
                document.getElementById("lessonDate").value;

            const studentId =
                document.getElementById("lessonStudent").value;

            const time =
                document.getElementById("lessonTime").value;

            const duration =
                Number(
                    document.getElementById("lessonDuration").value
                );

            const price =
                Number(
                    document.getElementById("lessonPrice").value
                );


            if (!date) {
                alert("Seleccioná una fecha.");
                return;
            }

            if (!studentId) {
                alert("Seleccioná un alumno.");
                return;
            }

            if (!time) {
                alert("Seleccioná una hora.");
                return;
            }

            if (!Number.isFinite(price) || price < 0) {
                alert("El precio no es válido.");
                return;
            }


            /*
                Máximo 4 alumnos simultáneos.

                Al editar una clase excluimos
                la propia clase del conteo.
            */

            const simultaneous =
                db.lessons.filter(lesson =>

                    lesson.date === date &&
                    lesson.time === time &&
                    lesson.id !== lessonId

                ).length;


            if (simultaneous >= 4) {

                alert(
                    "Ya hay 4 alumnos en ese horario."
                );

                return;
            }


            if (editingLesson) {

                editingLesson.date = date;
                editingLesson.studentId = studentId;
                editingLesson.time = time;
                editingLesson.duration = duration;
                editingLesson.price = price;

            } else {

                db.lessons.push({

                    id: generateId("lesson"),

                    date,

                    studentId,

                    time,

                    duration,

                    price,

                    status: "pending"

                });

            }


            saveDatabase();
            closeModal();


            /*
                Actualizamos la fecha seleccionada
                para que la interfaz muestre
                inmediatamente la clase.
            */

            state.selectedDate =
                dateFromKey(date);

            state.currentMonth =
                new Date(
                    state.selectedDate.getFullYear(),
                    state.selectedDate.getMonth(),
                    1
                );


            state.section = "day";

            render();

            showToast(
                editingLesson
                    ? "Clase actualizada"
                    : "Clase agregada"
            );

        });

}


function openModal() {

    document
        .getElementById("modalBackdrop")
        .classList.add("open");
}


function closeModal() {

    document
        .getElementById("modalBackdrop")
        .classList.remove("open");
}


document
    .getElementById("modalBackdrop")
    .addEventListener("click", event => {

        if (
            event.target.id === "modalBackdrop"
        ) {
            closeModal();
        }

    });


