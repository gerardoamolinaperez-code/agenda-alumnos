<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#1e293b">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Agenda alumnos">
<meta name="application-name" content="Agenda de alumnos particulares">
<meta name="description" content="Agenda personal para gestionar alumnos, clases y pagos">
<title>Agenda de alumnos particulares</title>
<link rel="manifest" href="./manifest.webmanifest">
<link rel="icon" type="image/png" sizes="32x32" href="./icons/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="./icons/icon-192.png">
<link rel="apple-touch-icon" href="./icons/apple-touch-icon.png">

<style>
:root {
    --primary: #1e293b;
    --primary-dark: #0f172a;
    --primary-soft: #334155;
    --bg: #f8fafc;
    --card: #ffffff;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e2e8f0;
    --success: #166534;
    --success-bg: #f0fdf4;
    --danger: #991b1b;
    --danger-bg: #fef2f2;
    --warning: #92400e;
    --warning-bg: #fffbeb;
    --accent: #475569;
}

* {
    box-sizing: border-box;
}

html {
    min-height: 100%;
}

body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    -webkit-font-smoothing: antialiased;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

.app {
    max-width: 900px;
    margin: 0 auto;
    min-height: 100vh;
}

/* HEADER */

.header {
    background: var(--primary);
    color: #f8fafc;
    padding: 18px 16px;
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--primary-dark);
}

.header-title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.02em;
}

.header-subtitle {
    font-size: 12px;
    opacity: .7;
    margin-top: 3px;
    font-weight: 400;
}

/* NAV */

.nav {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 8px 10px;
    background: white;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 68px;
    z-index: 15;
}

.nav button {
    flex: 0 0 auto;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    padding: 8px 12px;
    border-radius: 6px;
    font-weight: 500;
    font-size: 13px;
}

.nav button:hover {
    background: #f1f5f9;
    color: var(--text);
}

.nav button.active {
    background: var(--primary);
    color: white;
    border-color: var(--primary);
}

/* CONTENT */

.content {
    padding: 14px 12px;
    padding-bottom: 90px;
}

.card {
    background: var(--card);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
}

.card-title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--text);
    letter-spacing: 0.01em;
}

.muted {
    color: var(--muted);
}

.small {
    font-size: 13px;
}

/* BUTTONS */

.btn {
    width: 100%;
    border: 0;
    border-radius: 8px;
    background: var(--primary);
    color: white;
    padding: 10px 14px;
    font-weight: 500;
    font-size: 14px;
}

.btn:hover {
    background: var(--primary-dark);
}

.btn-secondary {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: white;
    color: var(--text);
    padding: 8px 12px;
    font-weight: 500;
    font-size: 13px;
}

.btn-secondary:hover {
    background: #f8fafc;
}

.btn-danger {
    border: 1px solid #fecaca;
    border-radius: 8px;
    background: var(--danger-bg);
    color: var(--danger);
    padding: 8px 12px;
    font-weight: 500;
    font-size: 13px;
}

.btn-success {
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    background: var(--success-bg);
    color: var(--success);
    padding: 8px 12px;
    font-weight: 500;
    font-size: 13px;
}

.btn-warning {
    border: 1px solid #fde68a;
    border-radius: 8px;
    background: var(--warning-bg);
    color: var(--warning);
    padding: 8px 12px;
    font-weight: 500;
    font-size: 13px;
}

/* FORMS */

.form-group {
    margin-bottom: 12px;
}

label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 5px;
    color: var(--muted);
    letter-spacing: 0.01em;
}

input,
select,
textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 12px;
    background: white;
    color: var(--text);
    transition: border-color 0.15s;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: #94a3b8;
}

textarea {
    min-height: 80px;
    resize: vertical;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 12px;
}

.actions button {
    flex: 1;
    min-width: 90px;
}

/* DASHBOARD */

.dashboard {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 12px;
}

.stat {
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px;
}

.stat-label {
    font-size: 11px;
    color: var(--muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.stat-value {
    font-size: 17px;
    font-weight: 600;
    margin-top: 4px;
    color: var(--text);
}

/* CALENDAR */

.calendar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 14px;
}

.calendar-title {
    text-align: center;
    font-weight: 600;
    text-transform: capitalize;
    font-size: 15px;
}

.weekdays,
.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
}

.weekday {
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    padding: 4px 0;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.calendar-day {
    min-height: 76px;
    background: #fafbfc;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 5px;
    cursor: pointer;
    overflow: hidden;
}

.calendar-day:hover {
    border-color: #94a3b8;
    background: #f1f5f9;
}

.calendar-day.today {
    border: 1.5px solid var(--primary);
    background: #f1f5f9;
}

.calendar-day.selected {
    background: #e2e8f0;
    border-color: #94a3b8;
}

.day-number {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
}

.lesson-mini {
    display: block;
    background: #e2e8f0;
    color: #334155;
    border-radius: 4px;
    padding: 2px 4px;
    margin-top: 3px;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
}

.lesson-mini.attended {
    background: #dcfce7;
    color: #166534;
}

.lesson-mini.absent {
    background: #fee2e2;
    color: #991b1b;
}

/* LESSON */

.lesson {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 8px;
    background: white;
}

.lesson-main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
}

.lesson-time {
    font-size: 18px;
    font-weight: 600;
    min-width: 60px;
    color: var(--text);
}

.lesson-name {
    font-weight: 600;
}

.lesson-info {
    color: var(--muted);
    font-size: 13px;
    margin-top: 3px;
}

.status {
    display: inline-block;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
}

.status.pending {
    background: #f1f5f9;
    color: #475569;
}

.status.attended {
    background: var(--success-bg);
    color: var(--success);
}

.status.absent {
    background: var(--danger-bg);
    color: var(--danger);
}

/* STUDENTS */

.student-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 8px;
    background: white;
}

.student-header {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.student-name {
    font-weight: 600;
}

.balance {
    font-weight: 600;
    font-size: 14px;
}

.balance.zero {
    color: var(--success);
}

.balance.pending {
    color: var(--danger);
}

/* PENDING LESSONS DETAIL */

.pending-lessons {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
}

.pending-lesson-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    padding: 6px 0;
    font-size: 13px;
    border-bottom: 1px solid #f3f4f6;
}

.pending-lesson-item:last-child {
    border-bottom: 0;
}

.pending-lesson-info {
    flex: 1;
}

.pending-lesson-amount {
    font-weight: 700;
    white-space: nowrap;
}

.pending-lesson-amount.partial {
    color: var(--warning);
}

.student-balance-block {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
}

.student-balance-block:last-child {
    border-bottom: 0;
}

.student-balance-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

/* PRINT / PDF */

@media print {
    body * {
        visibility: hidden !important;
    }
    #printArea,
    #printArea * {
        visibility: visible !important;
    }
    #printArea {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        padding: 16px;
        background: white;
        color: black;
    }
    .modal-backdrop {
        position: static !important;
        background: none !important;
        display: block !important;
        padding: 0 !important;
    }
    .modal {
        box-shadow: none !important;
        max-width: 100% !important;
        max-height: none !important;
        overflow: visible !important;
        padding: 0 !important;
        border-radius: 0 !important;
    }
    .no-print {
        display: none !important;
    }
}

.print-doc {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    max-width: 700px;
    margin: 0 auto;
    color: #0f172a;
    -webkit-font-smoothing: antialiased;
}

.print-doc h1 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 4px;
    color: #0f172a;
    letter-spacing: 0.01em;
}

.print-doc h2 {
    font-size: 13px;
    font-weight: 600;
    color: #0f172a;
    letter-spacing: 0.02em;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 6px;
}

.print-doc .meta {
    color: #64748b;
    font-size: 12px;
    margin-bottom: 20px;
}

.print-doc table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0;
    font-size: 12px;
}

.print-doc th,
.print-doc td {
    border: 1px solid #e2e8f0;
    padding: 8px 10px;
    text-align: left;
}

.print-doc th {
    background: #f8fafc;
    font-weight: 600;
    color: #475569;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.print-doc .total-row {
    font-weight: 600;
    background: #f8fafc;
}

.print-doc .status-attended { color: #166534; }
.print-doc .status-absent { color: #991b1b; }
.print-doc .status-pending { color: #475569; }

.print-doc .print-footer {
    margin-top: 28px;
    padding-top: 12px;
    border-top: 1px solid #e2e8f0;
    font-size: 11px;
    color: #94a3b8;
}

/* EMPTY */

.empty {
    text-align: center;
    color: var(--muted);
    padding: 28px 10px;
    font-size: 14px;
}

/* MODAL */

.modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.4);
    z-index: 100;
    padding: 15px;
    align-items: center;
    justify-content: center;
}

.modal-backdrop.open {
    display: flex;
}

.modal {
    background: white;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 12px;
    padding: 18px;
    border: 1px solid var(--border);
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.12);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.modal-title {
    font-size: 16px;
    font-weight: 600;
}

.close {
    border: 1px solid var(--border);
    background: white;
    border-radius: 6px;
    width: 32px;
    height: 32px;
    font-size: 16px;
    color: var(--muted);
}

.close:hover {
    background: #f8fafc;
    color: var(--text);
}

/* FAB */

.fab {
    position: fixed;
    right: 18px;
    bottom: 18px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 0;
    background: var(--primary);
    color: white;
    font-size: 24px;
    font-weight: 300;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
    z-index: 30;
}

.fab:hover {
    background: var(--primary-dark);
}

/* TOAST */

.toast {
    position: fixed;
    left: 50%;
    bottom: 85px;
    transform: translateX(-50%);
    background: var(--primary);
    color: white;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    z-index: 200;
    display: none;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
