        </div>


        <div class="form-group">

            <label>Alumno</label>

            <select id="paymentStudent">

                ${db.students.map(student => `
                    <option
                        value="${student.id}"
                        ${student.id === defaultStudentId ? "selected" : ""}
                    >
                        ${escapeHTML(student.name)}
                        — saldo ${formatMoney(
                            getStudentBalance(student.id)
                        )}
                    </option>
                `).join("")}

            </select>

        </div>

        <div id="paymentPendingPreview" class="small muted" style="margin-bottom:12px"></div>


        <div class="form-group">

            <label>Monto ($)</label>

            <input
                id="paymentAmount"
                type="number"
                min="0"
                step="1"
                placeholder="Ej.: 10000"
                value="${editingPayment ? Number(editingPayment.amount) || "" : ""}"
            >

        </div>


        <div class="form-group">

            <label>Fecha</label>

            <input
                id="paymentDate"
                type="date"
                value="${editingPayment ? editingPayment.date : todayKey()}"
            >

        </div>


        <div class="form-group">

            <label>Nota</label>

            <input
                id="paymentNote"
                placeholder="Opcional"
                value="${editingPayment ? escapeHTML(editingPayment.note || "") : ""}"
            >

        </div>


        <div class="actions">

            <button
                class="btn-secondary"
                id="cancelPayment"
            >
                Cancelar
            </button>

            <button
                class="btn"
                id="savePayment"
            >
                ${editingPayment ? "Guardar cambios" : "Guardar pago"}
            </button>

        </div>

    `;


    openModal();


    function updatePaymentPreview() {

        const studentId =
            document.getElementById("paymentStudent").value;

        const preview =
            document.getElementById("paymentPendingPreview");

        const maxAllowed = maxAllowedForStudent(studentId);

        const pending =
            getStudentPendingLessons(studentId);

        // Si estamos editando el pago del mismo alumno, mostramos
        // el saldo "como si este pago no existiera" para orientar.
        let info = `
            <div style="margin-bottom:6px">
                Monto máximo permitido: <b>${formatMoney(maxAllowed)}</b>
            </div>
        `;

        if (pending.length === 0 && !editingPayment) {
            info += "Este alumno no tiene clases pendientes.";
            preview.innerHTML = info;
            return;
        }

        if (pending.length > 0) {
            info += `
                <div style="margin-bottom:4px">
                    Clases con saldo (de más antigua a más reciente):
                </div>
                ${pending.map(l => `
                    <div>
                        · ${formatLessonDate(l.date)} ${escapeHTML(l.time)}
                        (${l.duration} min) — ${formatMoney(l.owed)}
                    </div>
                `).join("")}
            `;
        }

        preview.innerHTML = info;
    }

    updatePaymentPreview();

    document
        .getElementById("paymentStudent")
        .addEventListener("change", updatePaymentPreview);


    document
        .getElementById("closeModal")
        .addEventListener("click", closeModal);


    document
        .getElementById("cancelPayment")
        .addEventListener("click", closeModal);


    document
        .getElementById("savePayment")
        .addEventListener("click", () => {

            const studentId =
                document
                    .getElementById("paymentStudent")
                    .value;

            const amount =
                Number(
                    document
                        .getElementById("paymentAmount")
                        .value
                );

            const date =
                document
                    .getElementById("paymentDate")
                    .value;

            const note =
                document
                    .getElementById("paymentNote")
                    .value
                    .trim();


            if (!studentId) {

                alert(
                    "Seleccioná un alumno."
                );

                return;
            }


            if (
                !Number.isFinite(amount) ||
                amount <= 0
            ) {

                alert(
                    "Ingresá un monto válido."
                );

                return;
            }


            if (!date) {

                alert(
                    "Seleccioná una fecha."
                );

                return;
            }


            const maxAllowed = maxAllowedForStudent(studentId);

            if (amount > maxAllowed) {

                alert(
                    `El pago (${formatMoney(amount)}) supera el máximo permitido (${formatMoney(maxAllowed)}).`
                );

                return;
            }


            if (editingPayment) {

                editingPayment.studentId = studentId;
                editingPayment.amount = amount;
                editingPayment.date = date;
                editingPayment.note = note;

            } else {

                db.payments.push({

                    id: generateId("payment"),

                    studentId,

                    amount,

                    date,

                    note

                });

            }


            saveDatabase();
            closeModal();
            render();

            showToast(
                editingPayment
                    ? "Pago actualizado"
                    : "Pago registrado"
            );

        });

}


function deletePayment(paymentId) {

    const payment = db.payments.find(p => p.id === paymentId);

    if (!payment) {
        return;
    }

    const student = getStudent(payment.studentId);
    const name = student ? student.name : "este alumno";

    if (
        !confirm(
            `¿Eliminar el pago de ${formatMoney(payment.amount)} de ${name}?`
        )
    ) {
        return;
    }

    db.payments = db.payments.filter(p => p.id !== paymentId);

    saveDatabase();
    render();

    showToast("Pago eliminado");
}


