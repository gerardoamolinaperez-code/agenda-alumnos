/* RESPONSIVE */

@media (max-width: 600px) {
    .dashboard {
        grid-template-columns: 1fr 1fr;
    }

    .dashboard .stat:last-child {
        grid-column: span 2;
    }

    .calendar-day {
        min-height: 62px;
    }

    .lesson-mini {
        font-size: 9px;
    }
}

