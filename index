function openStudentPDF(studentId) {

    const student = getStudent(studentId);

    if (!student) {
        alert("Alumno no encontrado.");
        return;
    }

    const lessons = db.lessons
        .filter(l => l.studentId === studentId)
        .slice()
        .sort((a, b) => {
            const dateCmp = a.date.localeCompare(b.date);
            if (dateCmp !== 0) return dateCmp;
            return a.time.localeCompare(b.time);
        });

    // En el comprobante: solo clases ASISTIDAS cuentan para cobro y saldo.
    // Las pendientes no se consideran (aún no ocurrieron).
    const totalCharged = lessons
        .filter(l => l.status === "attended")
        .reduce((s, l) => s + Number(l.price || 0), 0);

    const totalPaid = db.payments
        .filter(p => p.studentId === studentId)
        .reduce((s, p) => s + Number(p.amount || 0), 0);

    const balance = Math.max(0, totalCharged - totalPaid);

    // Clases asistidas ordenadas (FIFO) + estado de pago de cada una
    const attendedLessons = lessons
        .filter(l => l.status === "attended")
        .slice()
        .sort((a, b) => {
            const dateCmp = a.date.localeCompare(b.date);
            if (dateCmp !== 0) return dateCmp;
            return a.time.localeCompare(b.time);
        });

    // paidStatusById: "yes" | "partial" | "no"
    const paidStatusById = {};
    let remainingPaid = totalPaid;
    const pendingLessons = [];

    for (const lesson of attendedLessons) {
        const price = Number(lesson.price) || 0;
        if (remainingPaid >= price) {
            remainingPaid -= price;
            paidStatusById[lesson.id] = "yes";
            continue;
        }
        if (remainingPaid > 0) {
            paidStatusById[lesson.id] = "partial";
            const owed = price - remainingPaid;
            pendingLessons.push({
                ...lesson,
                owed,
                originalPrice: price,
                partial: true
            });
            remainingPaid = 0;
        } else {
            paidStatusById[lesson.id] = "no";
            pendingLessons.push({
                ...lesson,
                owed: price,
                originalPrice: price,
                partial: false
            });
        }
    }

    // Rango del historial:
    // - Por defecto: últimos 30 días
    // - Si hay clases asistidas adeudadas más antiguas → desde la más antigua adeudada
    const today = new Date();
    const thirtyDaysAgo = new Date(
        today.getFullYear(),
        today.getMonth(),
        today.getDate() - 30,
        12, 0, 0, 0
    );
    const thirtyDaysKey = dateKeyFromDate(thirtyDaysAgo);

    let historialFromKey = thirtyDaysKey;

    const oldestUnpaid = attendedLessons.find(
        l => paidStatusById[l.id] === "no" || paidStatusById[l.id] === "partial"
    );

    if (oldestUnpaid && oldestUnpaid.date < thirtyDaysKey) {
        historialFromKey = oldestUnpaid.date;
    }

    const historialLessons = lessons.filter(
        l => l.date >= historialFromKey
    );

    const statusLabel = {
        pending: "Pendiente",
        attended: "Asistió",
        absent: "Faltó"
    };

    const statusClass = {
        pending: "status-pending",
        attended: "status-attended",
        absent: "status-absent"
    };

    let lessonsRows = "";

    if (historialLessons.length === 0) {
        lessonsRows = `
            <tr>
                <td colspan="5" style="text-align:center;color:#94a3b8">
                    Sin clases en el período
                </td>
            </tr>
        `;
    } else {
        lessonsRows = historialLessons.map(lesson => {
            const st = lesson.status || "pending";
            // Solo se muestra precio si asistió. Faltó y Pendiente = $0
            const displayPrice =
                st === "attended"
                    ? formatMoney(lesson.price)
                    : formatMoney(0);

            return `
                <tr>
                    <td>${formatLessonDate(lesson.date)}</td>
                    <td>${escapeHTML(lesson.time)}</td>
                    <td>${lesson.duration} min</td>
                    <td class="${statusClass[st] || ""}">
                        ${statusLabel[st] || st}
                    </td>
                    <td>${displayPrice}</td>
                </tr>
            `;
        }).join("");
    }

    let pendingRows = "";

    if (pendingLessons.length === 0) {
        pendingRows = `
            <tr>
                <td colspan="4" style="text-align:center;color:#94a3b8">
                    No hay saldo pendiente
                </td>
            </tr>
        `;
    } else {
        pendingRows = pendingLessons.map(lesson => `
            <tr>
                <td>${formatLessonDate(lesson.date)}</td>
                <td>${escapeHTML(lesson.time)}</td>
                <td>${lesson.duration} min</td>
                <td>${formatMoney(lesson.owed)}</td>
            </tr>
        `).join("");
    }

    const generatedAt = new Date().toLocaleString("es-AR", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
    });

    const html = `
        <div class="print-doc">

            <h1>Agenda de alumnos particulares</h1>
            <div class="meta">
                Comprobante de alumno · Generado: ${escapeHTML(generatedAt)}
            </div>

            <p style="font-size:14px;font-weight:600;margin:0 0 2px;color:#0f172a">
                ${escapeHTML(student.name)}
            </p>
            ${
                student.phone
                ? `<p style="margin:0 0 16px;font-size:12px;color:#64748b">
                    ${escapeHTML(student.phone)}
                   </p>`
                : `<p style="margin:0 0 16px"></p>`
            }

            <h2 style="margin:18px 0 8px">
                Historial de clases
                <span style="font-weight:400;font-size:11px;color:#94a3b8;text-transform:none;letter-spacing:0">
                    · últimos 30 días${
                        oldestUnpaid && oldestUnpaid.date < thirtyDaysKey
                        ? " o desde la clase adeudada más antigua"
                        : ""
                    }
                </span>
            </h2>

            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Duración</th>
                        <th>Estado</th>
                        <th>Precio</th>
                    </tr>
                </thead>
                <tbody>
                    ${lessonsRows}
                </tbody>
            </table>

            <h2 style="margin:22px 0 8px">
                Clases con saldo pendiente
                <span style="font-weight:400;font-size:11px;color:#94a3b8;text-transform:none;letter-spacing:0">
                    · pagos de más antigua a más reciente
                </span>
            </h2>

            <table>
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Duración</th>
                        <th>Adeuda</th>
                    </tr>
                </thead>
                <tbody>
                    ${pendingRows}
                </tbody>
            </table>

            <table style="margin-top:20px">
                <tr>
                    <td>Total clases asistidas</td>
                    <td style="text-align:right">${formatMoney(totalCharged)}</td>
                </tr>
                <tr>
                    <td>Total pagado</td>
                    <td style="text-align:right">${formatMoney(totalPaid)}</td>
                </tr>
                <tr class="total-row">
                    <td>Saldo adeudado</td>
                    <td style="text-align:right">${formatMoney(balance)}</td>
                </tr>
            </table>

            <div class="print-footer">
                Agenda de alumnos particulares · Documento generado automáticamente
            </div>

        </div>
    `;

    const modal = document.getElementById("modal");

    modal.innerHTML = `

        <div class="modal-header no-print">

            <div class="modal-title">
                Comprobante · ${escapeHTML(student.name)}
            </div>

            <button class="close" id="closeModal">×</button>

        </div>

        <div id="printArea">
            ${html}
        </div>

        <div class="actions no-print" style="margin-top:16px">

            <button class="btn-secondary" id="cancelPDF">
                Cerrar
            </button>

            <button class="btn" id="printPDF">
                Imprimir / Guardar PDF
            </button>

        </div>

    `;

    openModal();

    document.getElementById("closeModal")
        .addEventListener("click", closeModal);

    document.getElementById("cancelPDF")
        .addEventListener("click", closeModal);

    document.getElementById("printPDF")
        .addEventListener("click", () => {
            const originalTitle = document.title;

            const safeName = String(student.name || "alumno")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-zA-Z0-9]+/g, "_")
                .replace(/^_+|_+$/g, "")
                .toLowerCase() || "alumno";

            const now = new Date();
            // Formato local: DD-MM-YYYY_HH-MM-SS
            // (guiones en la hora: ":" no es válido en nombres de archivo en Windows)
            const fecha =
                String(now.getDate()).padStart(2, "0") +
                "-" +
                String(now.getMonth() + 1).padStart(2, "0") +
                "-" +
                String(now.getFullYear());
            const hora =
                String(now.getHours()).padStart(2, "0") +
                "-" +
                String(now.getMinutes()).padStart(2, "0") +
                "-" +
                String(now.getSeconds()).padStart(2, "0");

            // El navegador usa document.title como nombre por defecto al "Guardar como PDF"
            document.title = safeName + "_" + fecha + "_" + hora;

            window.print();

            setTimeout(() => {
                document.title = originalTitle;
            }, 1000);
        });
}


function openPaymentModal(paymentId = null) {

