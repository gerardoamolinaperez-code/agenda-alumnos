    // (porque ese monto ya está descontado del saldo).
    function maxAllowedForStudent(studentId) {
        const balance = getStudentBalance(studentId);
        if (
            editingPayment &&
            editingPayment.studentId === studentId
        ) {
            return balance + Number(editingPayment.amount || 0);
        }
        return balance;
