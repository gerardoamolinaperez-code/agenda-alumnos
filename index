        .getElementById("deleteAll")
        .addEventListener("click", deleteAllData);

}


function exportData() {

    const backup = {

        app: "Agenda de alumnos particulares",

        version: 4,

        exportedAt:
            new Date().toISOString(),

        data: db

    };


    const blob =
        new Blob(
            [JSON.stringify(backup, null, 2)],
            {
                type: "application/json"
            }
        );


    const url =
        URL.createObjectURL(blob);


    const link =
        document.createElement("a");


    link.href = url;

    link.download =
        "agenda-tutor-backup-" +
        todayKey() +
        ".json";


    document.body.appendChild(link);

    link.click();

    link.remove();

    URL.revokeObjectURL(url);


    showToast(
        "Respaldo exportado"
    );
}


function importData() {

    const input =
        document.getElementById("importFile");


    const file =
        input.files[0];


    if (!file) {

        alert(
            "Seleccioná primero un archivo JSON."
        );

        return;
    }


    if (
        !confirm(
            "Importar este respaldo reemplazará los datos actuales. ¿Continuar?"
        )
    ) {
        return;
    }


    const reader =
        new FileReader();


    reader.onload = () => {

        try {

            const parsed =
                JSON.parse(reader.result);


            /*
                Aceptamos tanto:

                { students, lessons, payments }

                como:

                { app, version, data }
            */

            const imported =
                parsed.data || parsed;


            if (
                !imported ||
                !Array.isArray(imported.students) ||
                !Array.isArray(imported.lessons) ||
                !Array.isArray(imported.payments)
            ) {

                throw new Error(
                    "Formato inválido"
                );

            }


            db = {

                students:
                    imported.students,

                lessons:
                    imported.lessons,

                payments:
                    imported.payments

            };


            saveDatabase();
            render();

            showToast(
                "Respaldo restaurado"
            );


        } catch (error) {

            console.error(error);

            alert(
                "No se pudo importar el respaldo. El archivo no parece ser válido."
            );

        }

    };


    reader.readAsText(file);

}


function deleteAllData() {

    const confirmation =
        prompt(
            'Para borrar todo escribí: BORRAR'
        );


    if (confirmation !== "BORRAR") {

        return;
    }


    db =
        structuredClone(DEFAULT_DB);


    saveDatabase();
    render();

    showToast(
        "Todos los datos fueron eliminados"
    );
}


