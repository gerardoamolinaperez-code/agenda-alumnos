function renderStudentList(search) {

    const list =
        document.getElementById("studentsList");


    const students =
        db.students.filter(student =>
            student.name
                .toLowerCase()
                .includes(search)
        );


    if (students.length === 0) {

        list.innerHTML = `
            <div class="card empty">
                ${
                    db.students.length === 0
